# Токен сообщества ВКонтакте (получается в Управление -> Работа с API -> Ключи доступа)
# Права токена: Сообщения сообщества, Фотографии, Управление сообществом
VK_TOKEN=vk1.a.your_token_here

# Префиксы команд через запятую (например: /,!,.)
COMMAND_PREFIXES=/,!,

# Путь к файлу базы данных SQLite
DATABASE_PATH=chat_manager.db

# ID разработчиков / создателей бота через запятую (для системных команд)
DEV_IDS=123456789

# Фотография-инструкция при добавлении бота в беседу:
# Вариант 1 (рекомендуется): прямая интернет-ссылка на картинку (https://.../photo.png)
INSTRUCTION_PHOTO_URL=
# Вариант 2: путь к локальному файлу
INSTRUCTION_PHOTO_PATH=assets/instruction.png
# Вариант 3: готовый attachment уже загруженного в ВК фото (например, photo-123456_7890)
INSTRUCTION_PHOTO_ATTACHMENT=
